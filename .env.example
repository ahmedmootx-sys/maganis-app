# Copy to .env.development.local / .env.production.local for personal overrides.
# VITE_APP_ENV: which environment this file targets: development | production | test
VITE_APP_ENV=development
# VITE_APP_NAME: human-readable application name shown in the UI (any non-empty text)
VITE_APP_NAME=مجانص
# VITE_STORAGE_PREFIX: namespace for all local data keys
#   (2-32 chars: lowercase letters, digits, dashes)
VITE_STORAGE_PREFIX=maganis-dev
# VITE_LOG_LEVEL: debug | info | warn | error (optional, default: info)
VITE_LOG_LEVEL=debug
# VITE_DEV_PORT: dev server port 1-65535 (optional, default: 5173, development only)
VITE_DEV_PORT=5173
