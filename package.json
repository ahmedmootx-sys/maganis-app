{
  "name": "bunyan",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/check-env.mjs development",
    "build": "tsc -b && vite build",
    "build:native": "node scripts/check-env.mjs native && npm run typecheck && vite build --mode native && cap sync android",
    "build:atlas": "node tools/atlas/build_atlas.mjs",
    "prebuild": "node scripts/check-env.mjs production",
    "preview": "vite preview",
    "qa:video": "node scripts/run-qa-video.mjs",
    "qa:native-smoke": "node qa/native-web-smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "check:env": "node scripts/check-env.mjs development",
    "check:emoji": "node scripts/check-emoji.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "catalog:check": "node scripts/check-catalog.mjs",
    "android:keystore": "node scripts/android-keystore.mjs",
    "gate:base-path": "node scripts/gate-base-path.mjs",
    "gate:brand-name": "node scripts/gate-brand-name.mjs",
    "verify": "node scripts/verify.mjs",
    "gates": "node scripts/gate-brand-name.mjs && node scripts/gate-no-personal-data.mjs && node scripts/gate-base-path.mjs && node scripts/gate-no-raw-vibrate.mjs && npm run check:emoji && npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && node scripts/check-coverage-ratchet.mjs && npm run build && node scripts/gate-raw-tokens.mjs && npm run check:ui && node qa/video-flow.mjs && node qa/media-everywhere.mjs && node qa/reset-flow.mjs && node qa/backup-restore.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/local-notifications": "8.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0",
    "@eslint/js": "^9.30.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.0",
    "lucide-static": "^1.57.0",
    "playwright": "^1.64.1",
    "potrace": "^2.1.8",
    "prettier": "^3.6.0",
    "three": "^0.186.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
