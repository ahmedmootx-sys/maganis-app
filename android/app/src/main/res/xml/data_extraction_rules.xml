<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include ONLY lightweight KV durable files -->
        <include domain="file" path="maganis/kv" />
        <!-- Exclude media uploads, snapshots, logs, and caches to stay under Google Cloud quota -->
        <exclude domain="file" path="maganis/media" />
        <exclude domain="file" path="maganis/snapshots" />
        <exclude domain="file" path="maganis/logs" />
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="maganis/kv" />
        <exclude domain="file" path="maganis/snapshots" />
        <exclude domain="file" path="maganis/logs" />
    </device-transfer>
</data-extraction-rules>

