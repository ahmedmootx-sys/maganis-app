# Development environment. Committed intentionally: placeholders only, no secrets.
# Personal local overrides belong in .env.development.local (gitignored).
# The storage prefix intentionally differs per environment so dev data and
# production data can never collide on the same browser origin.
VITE_APP_ENV=development
VITE_APP_NAME=مجانص
VITE_STORAGE_PREFIX=maganis-dev
VITE_LOG_LEVEL=debug
VITE_DEV_PORT=5173
