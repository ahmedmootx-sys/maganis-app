{
  "version": 1,
  "authored_by": "coach (Claude), 2026-10-18",
  "status": "naming_only",
  "note": "Arabic gym slang names (primary) with the scientific English name (secondary), for every atlas muscle id. sci_en is the anatomical identity of the id and matches atlas_muscles.json. gym_ar and gym_ar_alt are colloquial names, not scientific claims. where_ar is a plain location hint. Do not change ids. Do not add or remove ids without updating the atlas.",
  "display_rule": {
    "primary_line": "gym_ar",
    "secondary_line": "sci_en, rendered inside <bdi dir=\"ltr\">, smaller, muted colour",
    "chip_label": "short_ar",
    "detail_sheet_lines": [
      "gym_ar",
      "sci_en",
      "where_ar",
      "group name",
      "note_ar when atlas != mesh"
    ],
    "search_matches": ["gym_ar", "short_ar", "gym_ar_alt", "sci_en"],
    "never_show": "the old formal Arabic names (for example الدالية، المستقيمة الفخذية) anywhere in the UI; they survive only inside gym_ar_alt for search"
  },
  "atlas_values": {
    "mesh": "drawn from a real BodyParts3D mesh",
    "derived_approx": "geometric split of one mesh; label as approximate",
    "no_mesh": "no mesh exists in BodyParts3D 4.0; cannot be painted; show text only"
  },
